@{
    ViewData["Title"] = "Plano de Contas";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<button type="button" class="btn btn-block btn-primary" onclick="Novo()">Criar item de Plano de Conta</button>
<br><br>
<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Descricao</th>
        <th>Tipo</th>
        <th>#</th>
        <th>#</th>
    </tr>

    @{
        foreach(var item in (List<PlanoContaModel>)ViewBag.ListaPlanoConta)
        {
           <tr>
                <td>@item.Id</td>
                <td>@item.Descricao</td>
                <td>@item.Tipo</td>
                <td><button type="button" class="btn btn-block btn-outline-warning" onclick="Atualizar(@item.Id.ToString())">Editar</button></td>
                <td>
                    <form asp-controller="PlanoConta" asp-action="Excluir" asp-route-Id="@item.Id" method="post" onsubmit="return confirm('Deseja realmente excluir este registro?');">
                        <button type="submit" class="btn btn-block btn-outline-danger">Excluir</button>
                    </form>
                </td>
            </tr> 
        }
    }
</table>


<script>
    function Novo()
    {
        window.location.href = "../PlanoConta/Cadastrar";
    }

    function Atualizar(id)
    {
        window.location.href = "../PlanoConta/Cadastrar/" + id;
    }

</script>

