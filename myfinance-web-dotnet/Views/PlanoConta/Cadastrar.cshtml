@model myfinance_web_dotnet.Models.PlanoContaModel 

@{
    ViewData["Title"] = "Criar Plano de Contas";
}

<h1>@ViewData["Title"]</h1>

<div>
    <form asp-controller="PlanoConta" asp-action="Cadastrar" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" /><br>

        <label>Descricao</label><br>
        <input type="Text" asp-for="Descricao"/><br>
        <span asp-validation-for="Descricao" class="text-danger"></span><br>

        <br>
        <label>Tipo</label><br>
        <label>@Html.RadioButtonFor(m => m.Tipo, "D")Despesa</label>
        <label>@Html.RadioButtonFor(m => m.Tipo, "R")Receita</label>
        <label>@Html.RadioButtonFor(m => m.Tipo, "I")Investimento</label>
        <br><span asp-validation-for="Tipo" class="text-danger"></span>

        <br><br>
        <button type="submit" class="btn btn-block btn-success">Registrar</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
