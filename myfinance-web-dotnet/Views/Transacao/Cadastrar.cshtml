@model myfinance_web_dotnet.Models.TransacaoModel 

@{
    ViewData["Title"] = "Registrar Transacao Financeira";
}

<h1>@ViewData["Title"]</h1>

<div>
    <form asp-controller="Transacao" asp-action="Cadastrar" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" /><br> 

        <div class="form-group">
            <label>Data:</label><br>
            <input type="date" class="form-control" asp-for="Date"/>
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Valor:</label><br>
            <input type="text" class="form-control" asp-for="Valor" step="0.01"/>
            <span asp-validation-for="Valor" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Plano de Conta:</label><br>
            @Html.DropDownListFor(  x => x.PlanoContaId, Model.ListPlanoConta, new {@class="form-select"})
            <span asp-validation-for="PlanoContaId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Historico:</label><br>
            <input type="text" class="form-control" asp-for="Historico"/>
            <span asp-validation-for="Historico" class="text-danger"></span>
        </div>

        <br><br>
        <button type="submit" class="btn btn-block btn-success">Registrar</button>
        
    </form>
</div>
