@using Microsoft.AspNetCore.Components.Web
@{
    ViewData["Title"] = "Transacoes Financeiras Recorrentes";
}

<h1>@ViewData["Title"]</h1>

<button type="button" class="btn btn-block btn-primary" onclick="Novo()">Registrar Transacao Recorrente</button>
<br>
<br>
<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Data de Inicio</th>
        <th>Data de fim</th>
        <th>Tipo</th>
        <th>Valor</th>
        <th>#</th>
        <th>#</th>
    </tr>

    @{
        foreach (var item in (List<TransacaoRecorrenteModel>)ViewBag.ListaTransacaoRecorrente)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.DataInicio</td>
                <td>@item.DataFim</td>
                <td>@item.PlanoConta.Tipo</td>
                <td>@item.Valor</td>
                <td><button type="button" class="btn btn-block btn-outline-warning" onclick="Atualizar(@item.Id.ToString())">Editar</button></td>
                <td><button type="button" class="btn btn-block btn-outline-danger" onclick="Excluir(@item.Id.ToString())">Excluir</button></td>
            </tr>
        }
    }
</table>


<script>
    function Novo()
    {
        window.location.href = "../TransacaoRecorrente/Cadastrar";
    }

    function Atualizar(id)
    {
        window.location.href = "../TransacaoRecorrente/Cadastrar/" + id;
    }

    function Excluir(id)
    {
        window.location.href = "../TransacaoRecorrente/Excluir/" + id;
    }

</script>

